# Every value here has a working default; nothing needs to be set to run locally.

# Where saves are written.
GCP_PROJECT=ff-python-api
BQ_DATASET=projections
BQ_TABLE=player_projections
BQ_LOCATION=US

# Turn off to use the dashboard with browser-only saving.
BIGQUERY_ENABLED=true

# The server binds to loopback because it writes to BigQuery with this machine's
# credentials. Only change these if you are deploying it somewhere — and if you
# do, set API_TOKEN as well, or you have published a write endpoint.
HOST=127.0.0.1
PORT=8000
API_TOKEN=
